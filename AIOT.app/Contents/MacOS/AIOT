#!/bin/zsh
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
NODE_BIN="$(/bin/zsh -lc 'command -v node' 2>/dev/null)"

if [[ -z "$NODE_BIN" ]]; then
  /usr/bin/osascript -e 'display alert "AIOT 需要 Node.js" message "請先安裝 Node.js，再重新開啟 AIOT。" as critical'
  /usr/bin/open "https://nodejs.org/"
  exit 1
fi

if "$NODE_BIN" "$ROOT/scripts/aiot-service.mjs" start; then
  /usr/bin/open "http://127.0.0.1:${AIOT_LOCAL_PORT:-8888}/"
else
  /usr/bin/osascript -e 'display alert "AIOT 無法啟動" message "請查看專案內 .aiot/aiot.log。" as critical'
  exit 1
fi
